# Application identity
APP_NAME=SovereignAI Workbench
APP_VERSION=0.2.0
DEBUG=False

# Server
HOST=127.0.0.1
PORT=8000

# Logging
LOG_LEVEL=INFO

# Database URL (reserved for future use)
# Example: DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_ai
DATABASE_URL=

# Model configuration (reserved for future AI integration)
# Path to a local directory containing model weights
MODELS_PATH=./models
# Default model name to use (e.g. llama3, mistral, phi3)
DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# Model gateway (Phase 2B)
# ---------------------------------------------------------------------------
# LLM__PROVIDER selects the active provider. For this phase the only
# supported value is "ollama". Other values cause a ConfigurationError at
# gateway construction time.
LLM__PROVIDER=ollama

# Ollama provider configuration.
# OLLAMA_BASE_URL must point at a loopback host (127.0.0.1, ::1, localhost).
# The provider will refuse to start against any other host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL is used when a request does not specify a model.
# Example values: llama3, llama3:8b, mistral, phi3, qwen2
OLLAMA_DEFAULT_MODEL=
# OLLAMA_REQUEST_TIMEOUT_SECONDS is the HTTP timeout for Ollama calls.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# OCR & Vision (Phase 5C)
# ---------------------------------------------------------------------------
# The real OCR/Vision providers talk to the same local Ollama server. Point
# them at a vision-capable model (e.g. qwen2.5vl:3b, llava). The base URL must
# be a loopback host; the providers refuse to construct against any other host.
# Leave VISION__DEFAULT_MODEL / OCR__DEFAULT_MODEL empty to require an explicit
# model at construction time.
VISION__DEFAULT_MODEL=
OCR__DEFAULT_MODEL=
OCR__REQUEST_TIMEOUT_SECONDS=120
VISION__REQUEST_TIMEOUT_SECONDS=120
